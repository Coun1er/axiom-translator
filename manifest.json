{
  "manifest_version": 3,
  "name": "Axiom Translator",
  "version": "1.1.5",
  "description": "Перевод Twitter-ховеров и AI-разбор нарратива из данных Pulse по нажатию.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs", "storage"],
  "options_page": "options.html",
  "action": { "default_title": "Настройки переводчика и AI", "default_popup": "options.html?popup=1" },
  "host_permissions": [
    "https://*.axiom.trade/*",
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://openrouter.ai/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://axiom.trade/*", "https://*.axiom.trade/*"],
      "js": ["pulse-context.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.axiom.trade/*"],
      "js": ["hover-panel.js"],
      "css": ["hover-panel.css"],
      "run_at": "document_idle"
    }
  ]
}
